# PetFeedr Configuration
# Copy this file to SecretKeys.py and fill in your values

# ==============================================================================
# REQUIRED: Web Interface Authentication
# ==============================================================================
PETFEEDR_USER_ID = 'your_username'
PETFEEDR_PASSWORD = 'your_password'
PETFEEDR_SECRET_KEY = 'generate-a-random-secret-key-here'

# ==============================================================================
# OPTIONAL: Pushover Notifications
# ==============================================================================
# Set to True to enable push notifications when food is dispensed
# You can also disable via environment variable: PUSHOVER_ENABLED=false
PUSHOVER_ENABLED = False

# Get these from https://pushover.net/
PUSHOVER_API_TOKEN = ''
PUSHOVER_USER_KEY = ''

# ==============================================================================
# SIMULATION MODE
# ==============================================================================
# You can run PetFeedr in simulation mode for development/testing:
#   PETFEEDR_SIMULATE=true python3 PetFeedr.py
#
# In simulation mode:
#   - No GPIO/hardware is touched
#   - Motor movements are logged but not executed  
#   - Pushover notifications are simulated (logged, not sent)
#
# Simulation mode is also auto-enabled if RPi.GPIO is not available
# (e.g., when running on a laptop/desktop for development)
